# ── Banco de Dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pta_dados

# ── Gemini (extração de PDFs e embeddings) ────────────────────────────────────
GEMINI_API_KEY=sua_chave_aqui

# ── LLM do Agente ─────────────────────────────────────────────────────────────
# Provedor: "gemini" ou "groq"
LLM_PROVIDER=gemini
LLM_API_KEY=sua_chave_aqui
LLM_MODEL=gemini-2.0-flash

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_KEY=troque_por_uma_chave_segura

# ── Planilhas ─────────────────────────────────────────────────────────────────
SHEET_ID=id_da_planilha_aqui

# ── PDFs ──────────────────────────────────────────────────────────────────────
PDF_DIR=data/pdfs
